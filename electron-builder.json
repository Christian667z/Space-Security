{
  "appId": "com.spacesecurity.cyberdefense",
  "productName": "Space Security",
  "directories": {
    "output": "dist-package"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "nodeGypRebuild": false,
  "npmRebuild": false,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "requireAdministrator"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Space Security"
  },
  "portable": {
    "artifactName": "Space-Security-Portable.exe"
  }
}
