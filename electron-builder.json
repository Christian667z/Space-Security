{
  "appId": "com.spacesecurity.cyberdefense",
  "productName": "Space Security",
  "copyright": "Copyright © 2026 Space Security. Tous droits réservés.",
  "directories": {
    "output": "dist-package"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "nodeGypRebuild": false,
  "npmRebuild": false,
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "requireAdministrator",
    "publisherName": "Space Security Cybersecurity Labs",
    "verifyUpdateCodeSignature": true,
    "signingHashAlgorithms": ["sha256"],
    "rfc3161TimeStampServer": "http://timestamp.digicert.com",
    "signAndEditExecutable": true,
    "legalTrademarks": "Space Security™",
    "sign": "scripts/sign-windows.cjs"
  },
  "linux": {
    "icon": "build/icon.png",
    "target": ["AppImage", "tar.gz"]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Space Security"
  },
  "portable": {
    "artifactName": "Space-Security-Portable.exe"
  }
}
