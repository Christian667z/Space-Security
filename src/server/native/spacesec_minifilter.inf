;;;
;;; Space Security Kernel Minifilter Driver Installation File
;;;

[Version]
Signature   = "$Windows NT$"
Class       = "AntiVirus"
ClassGuid   = {b1d072a4-bee2-4808-8826-b13b423d16b0}
Provider    = %ProviderString%
DriverVer   = 10/14/2026,3.0.0.1
CatalogFile = spacesec_minifilter.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir          = 12
MiniFilter.DriverFiles  = 12            ;%windir%\system32\drivers

[DefaultInstall]
OptionDesc          = %ServiceDescription%
CopyFiles           = MiniFilter.DriverFiles

[DefaultInstall.Services]
AddService          = %ServiceName%,,MiniFilter.Service

[DefaultUninstall]
DelFiles   = MiniFilter.DriverFiles

[DefaultUninstall.Services]
DelService = %ServiceName%,0x200

[MiniFilter.Service]
DisplayName      = %ServiceName%
Description      = %ServiceDescription%
ServiceBinary    = %12%\%DriverName%.sys
Dependencies     = "FltMgr"
ServiceType      = 2                            ;SERVICE_FILE_SYSTEM_DRIVER
StartType        = 3                            ;SERVICE_DEMAND_START
ErrorControl     = 1                            ;SERVICE_ERROR_NORMAL
LoadOrderGroup   = "FSFilter Anti-Virus"
AddReg           = MiniFilter.AddRegistry

[MiniFilter.AddRegistry]
HKR,,"DebugFlags",0x00010001,0x0
HKR,,"SupportedFeatures",0x00010001,0x3
HKR,"Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Instances\"%Instance1.Name%,"Altitude",0x00000000,%Instance1.Altitude%
HKR,"Instances\"%Instance1.Name%,"Flags",0x00010001,%Instance1.Flags%

[MiniFilter.DriverFiles]
%DriverName%.sys

[Strings]
ProviderString          = "Space Security CyberDefense"
ServiceDescription      = "Space Security Kernel Minifilter EDR Sensor"
ServiceName             = "SpaceSecMinifilter"
DriverName              = "spacesec_minifilter"
DefaultInstance         = "SpaceSecMinifilter Instance"
Instance1.Name          = "SpaceSecMinifilter Instance"
Instance1.Altitude      = "320500"
Instance1.Flags         = 0x0              ; Allow all attachments
